# --- zaroori ---
GROQ_API_KEY=yahan_nayi_key_daalein

# --- private beta ---
# Har tester ko alag code dein (comma se alag). Khali chhodne par sab khule rahenge (sirf apne computer par test ke liye).
ACCESS_CODES=BETA-RAHUL,BETA-PRIYA,BETA-AMIT
CODE_MINUTES=30            # har code ke kul minutes
MAX_VIDEO_MINUTES=5        # ek video ki limit
ADMIN_KEY=koi-lamba-secret # /api/admin/usage?key=... se dekhein kisne kitna use kiya

# --- optional ---
USD_INR=90                 # aaj ka dollar rate (kharcha Rs me dikhane ke liye)
RATE_LIMIT=120             # ek IP se 10 minute me kitni requests
# GROQ_CHAT_MODEL=openai/gpt-oss-120b
# DATA_DIR=./data          # usage.json yahan save hota hai

# --- links (khali = band) ---
FEEDBACK_URL=              # Google Form ya mailto: link. Khali chhodne par app se Feedback button gayab
ACCESS_REQUEST_URL=        # "Request access" ka link (khali ho to FEEDBACK_URL use hota hai)
CONTACT_EMAIL=             # landing page ke footer me dikhta hai
